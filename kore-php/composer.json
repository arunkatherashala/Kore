  "license": "MIT",
  "authors": [
    {
      "name": "Sai Arun Kumar Katherashala",
      "email": "arunkatherashala@gmail.com"
    }
  ],
  "homepage": "https://github.com/arunkatherashala/Kore",
  "support": {
