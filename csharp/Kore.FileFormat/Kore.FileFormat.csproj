<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net6.0;net7.0;net8.0;netstandard2.1</TargetFrameworks>
    <AssemblyName>KoreFileFormat</AssemblyName>
    <RootNamespace>Kore</RootNamespace>
    <Version>1.7.0</Version>
    <AssemblyVersion>1.7.0.0</AssemblyVersion>
    <FileVersion>1.7.0.0</FileVersion>
    <PackageId>KoreFileFormat</PackageId>
    <PackageVersion>1.7.0</PackageVersion>
    <Authors>Sai Arun Kumar Katherashala</Authors>
    <Company>KORE</Company>
    <Description>KORE Binary Format — columnar file format with 11 ACID features. Supports CRC32, ZSTD compression, Bloom filters, AES-256-GCM encryption, schema evolution, MVCC time travel, partition evolution, row-level deletes. 8-language FFI via Rust kore-ffi.</Description>
    <PackageTags>kore;columnar;binary;format;ACID;analytics;compression;FFI</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/arunkatherashala/Kore</PackageProjectUrl>
    <RepositoryUrl>https://github.com/arunkatherashala/Kore.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Condition="Exists('..\..\README.md')" />
  </ItemGroup>
</Project>
